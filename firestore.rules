rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // ── Users collection ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow get:  if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Allow mobile users to create their own account document, as long as they don't set role='admin' or 'superadmin'
      allow create: if (
        isSignedIn() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) ||
          !(request.resource.data.role in ['admin', 'superadmin']))
      ) || isAdmin();

      // Allow mobile users to update their own document, as long as they don't escalate to admin/superadmin
      allow update: if (
        isSignedIn() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) ||
          !(request.resource.data.role in ['admin', 'superadmin']))
      ) || isAdmin();

      allow delete: if isAdmin();

      // Allow users to access their own nested subcollections
      match /{document=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Transactions ──────────────────────────────────────────────────────────
    match /transactions/{txnId} {
      allow read:           if isAdmin();
      allow create:         if isSignedIn();   // mobile app
      allow update, delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow create: if isSignedIn() || (
        request.resource.data.type == 'complaint' &&
        request.resource.data.read == false &&
        request.resource.data.keys().hasAll(['title', 'body', 'type', 'read', 'email', 'createdAt'])
      );

      allow get: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid);

      allow list: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid
            && request.auth.uid == request.resource.data.uid);

      allow delete: if isAdmin();
    }

    // ── Analytics / chart collections ────────────────────────────────────────
    match /monthlyRevenue/{docId}   { allow read, write: if isAdmin(); }
    match /userDistribution/{docId} { allow read, write: if isAdmin(); }
    match /categorySpending/{docId} { allow read, write: if isAdmin(); }
    match /activityLog/{docId}      { allow read, write: if isAdmin(); }
    match /userGrowth/{docId}       { allow read, write: if isAdmin(); }
    match /quickMetrics/{docId}     { allow read, write: if isAdmin(); }

    // ── Admin Password Recovery ───────────────────────────────────────────────
    match /admin_recovery/{emailHash} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // ── Super Admin — Feature Flags ───────────────────────────────────────────
    // Super admin writes; all admins can read (for UI feature gating)
    match /featureFlags/{docId} {
      allow read:  if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Super Admin — Audit Log ───────────────────────────────────────────────
    // Admins/superadmins can write entries; only superadmin can read the full log
    match /auditLog/{docId} {
      allow read:  if isSuperAdmin();
      allow write: if isAdmin();
    }

    // ── Business & Billing collections ────────────────────────────────────────
    match /businesses/{docId}  { allow read, write: if isSignedIn(); }
    match /revenues/{docId}    { allow read, write: if isSignedIn(); }
    match /expenses/{docId}    { allow read, write: if isSignedIn(); }
    match /invoices/{docId}    { allow read, write: if isSignedIn(); }
    match /utilityBill/{docId} { allow read, write: if isSignedIn(); }

    // ── Block everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
